#![allow(unused)]
use crate::State;
use crossbeam::channel::{self, Receiver, Sender, select};
use std::time::{self, Duration, Instant};

enum RaftState {
    Follower,
    Candidate,
}

struct Machine {
    state: State,
    raft_state: RaftState,
}

impl Machine {
    fn new(id: u32) -> Machine {
        Machine {
            state: State::default(id),
            raft_state: RaftState::Follower,
        }
    }

    fn run(&mut self) -> Result<(), Box<dyn std::error::Error>> {
        let mut current_state = RaftState::Follower;
        loop {
            match current_state {
                RaftState::Follower => {
                    let (send_reset_timer, receiver_reset_timer) = channel::unbounded::<()>();
                    let (send_timeout_elapsed, receive_timeout_elapsed) =
                        channel::unbounded::<()>();
                    current_state = run_follower(Duration::from_secs(2), receive_timeout_elapsed)?;
                }
                RaftState::Candidate => {
                    println!("inside candidate state now");
                    loop {}
                }
            }
        }
    }

}

fn start_timer(timeout: Duration, notify_timeout_elapsed: Sender<()>, reset_timer: Receiver<()>) {
    let mut deadline = Instant::now() + timeout;
    std::thread::spawn(move || {
        loop {
            let remaining = deadline.saturating_duration_since(Instant::now());
            select! {
                recv(reset_timer) -> sig => {
                    if let Err(err) = sig {
                        println!("recvd err from reset_timer: {}", err);
                        return;
                    };

                    deadline = Instant::now() + timeout;
                    println!("resetting timer {:?}", deadline);
                }
                default() => {
                    notify_timeout_elapsed.send(());
                    return;
                }
            }
        }
    });
}

fn run_follower(
    timeout: Duration,
    receive_timeout_elapsed: Receiver<()>,
) -> Result<RaftState, Box<dyn std::error::Error>> {
    loop {
        select! {
            recv(receive_timeout_elapsed) -> sig => {
                println!("timeout has elasped, extending to candidate state");
                return Ok(RaftState::Follower);
            }
        }
    }
}
